                  "labelKey": "highlight_icon.handshake"
                },
                {
                  "key": "savings",
                  "icon": "savings",
                  "labelKey": "highlight_icon.savings"
                },
                {
                  "key": "favorite",
                  "icon": "favorite",
                  "labelKey": "highlight_icon.favorite"
                },
                {
                  "key": "thumb_up",
                  "icon": "thumb_up",
                  "labelKey": "highlight_icon.thumb_up"
                }
              ]
            },
            {
              "key": "title",
              "type": "text",
              "labelKey": "field.item_title",
              "required": true,
              "maxLength": 40
            },
            {
              "key": "text",
              "type": "multiline",
              "labelKey": "field.item_text",
              "maxLength": 120
            }
          ]
        }
      ]
    },
    {
      "key": "achievements",
