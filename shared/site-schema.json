          "labelKey": "field.bio",
          "maxLength": 600
        },
        {
          "key": "designation",
          "type": "text",
          "labelKey": "field.designation",
          "maxLength": 60
        },
        {
          "key": "yearsExperience",
          "type": "number",
          "labelKey": "field.years_experience",
          "min": 0,
          "max": 70
