        {
          "key": "showAgencyCode",
          "type": "toggle",
          "labelKey": "field.show_agency_code",
          "default": false
        }
      ]
    },
    {
      "key": "services",
      "labelKey": "section.services",
      "icon": "work",
      "defaultVisible": true,
      "fields": [
        {
          "key": "offered",
          "type": "multiSelect",
          "labelKey": "field.offered",
          "optionsFrom": "catalog.interests"
        },
        {
          "key": "items",
          "type": "list",
          "labelKey": "field.service_items",
          "maxItems": 8,
          "itemFields": [
            {
              "key": "interest",
              "type": "select",
              "labelKey": "field.interest",
              "required": true,
              "optionsFrom": "catalog.interests"
            },
            {
              "key": "description",
              "type": "multiline",
              "labelKey": "field.description",
              "maxLength": 160
            }
          ]
        }
      ]
    },
    {
      "key": "offers",
      "labelKey": "section.offers",
      "icon": "savings",
      "defaultVisible": false,
      "fields": [
        {
          "key": "title",
          "type": "text",
          "maxLength": 40,
          "labelKey": "field.offers_title",
          "defaultKey": "site.offers_title_default"
        },
        {
          "key": "items",
          "type": "offerList",
          "maxItems": 6,
          "labelKey": "field.offers_items"
        },
        {
          "key": "custom",
          "type": "list",
          "maxItems": 6,
          "labelKey": "field.custom_offers",
          "itemFields": [
            {
              "key": "id",
              "type": "text",
              "generated": "uuid",
              "labelKey": "field.offer_id"
            },
            {
              "key": "title",
              "type": "text",
              "required": true,
              "maxLength": 60,
              "labelKey": "offer_field.title"
            },
            {
              "key": "summary",
              "type": "multiline",
              "maxLength": 160,
              "labelKey": "offer_field.summary"
            },
            {
              "key": "endsOn",
              "type": "date",
              "required": true,
              "maxDaysAhead": 366,
              "labelKey": "offer_field.ends_at"
            },
            {
              "key": "ctaKind",
              "type": "select",
              "required": true,
              "optionsFrom": "catalog.offerCtaKinds",
              "labelKey": "offer_field.cta_kind"
            },
            {
              "key": "interest",
              "type": "select",
              "optionsFrom": "catalog.interests",
              "labelKey": "offer_field.interest"
            },
            {
              "key": "confirmed",
              "type": "toggle",
              "equals": true,
              "labelKey": "field.custom_offer_confirm"
            }
          ]
        }
      ]
    },
    {
