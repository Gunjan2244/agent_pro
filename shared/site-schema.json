{
  "version": 1,
  "sections": [
    {
      "key": "hero",
      "labelKey": "section.hero",
      "icon": "badge",
      "pinned": true,
      "defaultVisible": true,
      "fields": [
        {
          "key": "headline",
          "type": "text",
          "labelKey": "field.headline",
          "required": true,
          "maxLength": 70
        },
        {
          "key": "subheadline",
          "type": "multiline",
          "labelKey": "field.subheadline",
          "maxLength": 160
        },
        {
          "key": "photo",
          "type": "image",
          "labelKey": "field.photo",
          "aspect": "1:1"
        },
        {
          "key": "ctaLabel",
          "type": "text",
          "labelKey": "field.cta_label",
          "maxLength": 30,
          "defaultKey": "site.cta_default"
        },
        {
          "key": "featuredOffer",
          "type": "offerRef",
          "labelKey": "field.featured_offer"
        }
      ]
    },
    {
      "key": "about",
      "labelKey": "section.about",
      "icon": "person",
      "defaultVisible": true,
