// Cloudflare Worker serving the public-site renderer (docs/WEB_RENDERER.md). Static assets, plus a Worker script
// (worker.js) that runs ONLY for the pages (server-side rendering, DECISIONS #75), the manifest (DECISIONS #65),
// robots.txt and sitemap.xml; every other path (fonts, CSS, JS, JSON) is served straight from web/dist without invoking it.
// Build first: sh scripts/build-web.sh  (writes web/dist). Deploy (needs the user's approval):
//   npx wrangler@4.151.1 deploy --config web/wrangler.jsonc
{
  "name": "agentpro-sites",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Reads Supabase settings from dist/config.js at request time, so no keys live in this file.
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // every unknown path serves /index.html with 200: the shell the Worker falls back to, and /terms
    "not_found_handling": "single-page-application",
    // an explicit list, so static assets never invoke the Worker
    "run_worker_first": ["/", "/a/*", "/privacy", "/manifest.webmanifest", "/robots.txt", "/sitemap.xml"]
  }
  // No routes / custom domains yet: the platform domain is not bought (DECISIONS #59).
}
