// Cloudflare Worker serving the public-site renderer (docs/WEB_RENDERER.md). Static assets, plus a Worker script
// (worker.js) that runs ONLY for the pages (server-side rendering, DECISIONS #75), the manifest (DECISIONS #65),
// robots.txt and sitemap.xml; every other path (fonts, CSS, JS, JSON) is served straight from web/dist without invoking it.
// Build first: sh scripts/build-web.sh  (writes web/dist). Deploy (needs the user's approval):
//   npx wrangler@4.151.1 deploy --config web/wrangler.jsonc
{
  "name": "agentpro-sites",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Reads Supabase settings from dist/config.js at request time, so no keys live in this file.
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // every unknown path serves /index.html with 200: the shell the Worker falls back to, and /terms
    "not_found_handling": "single-page-application",
    // an explicit list, so static assets never invoke the Worker
    "run_worker_first": ["/", "/a/*", "/my", "/my/*", "/join", "/join/*", "/privacy", "/manifest.webmanifest", "/robots.txt", "/sitemap.xml"]
  },
  // Throttles the portal's POSTs per client IP (10 per 60 s); worker.js skips the check when the binding is absent.
  // namespace_id is any unique integer string in the account. Unverified against the wrangler schema (see the changelog).
  "ratelimits": [
    { "name": "PORTAL_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // The customer sign-up page's POSTs (consent, autosave every ~600 ms of typing, heartbeat, submit): 120 per 60 s per client IP.
    { "name": "JOIN_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
  // PORTAL_RPC_KEY is a Worker SECRET, never a var and never in config.js (DECISIONS #101). Set it with:
  //   npx wrangler@4.151.1 secret put PORTAL_RPC_KEY --config web/wrangler.jsonc
  // The Worker sends it as x-portal-key on the portal RPCs; without it the portal answers 503 (fails closed).
  // No routes / custom domains yet: the platform domain is not bought (DECISIONS #59).
}
