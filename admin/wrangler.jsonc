// Cloudflare Worker with static assets for the admin panel (docs/OFFERS.md, Hosting). No Worker script.
// Build first: cd admin && VITE_SUPABASE_URL=... VITE_SUPABASE_ANON_KEY=... npm run build
// Deploy (needs the user's approval each time): npx wrangler@4.151.1 deploy --config admin/wrangler.jsonc
{
  "name": "agentpro-admin",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
